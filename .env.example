# ==============================================================================
# Environment Configuration - HRMS Platform
# ==============================================================================

NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://hrms_user:hrms_password@localhost:5432/hrms_db?schema=public
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=hrms_password
POSTGRES_DB=hrms_db
POSTGRES_PORT=5432

# Backend API Configuration
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super-secret-hrms-jwt-token-change-in-production-min32chars
JWT_EXPIRATION=8h

# Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="PeopleOS HRMS"
NEXT_PUBLIC_APP_ENV=development

# Infrastructure
NGINX_PORT=80
