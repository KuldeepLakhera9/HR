# ==============================================================================
# PeopleOS HRMS — Root Docker Build Ignore Configuration
# ==============================================================================

# Version Control & Tooling
.git
.gitignore
.gitattributes
.github
.husky
.turbo

# Dependencies & Build Output
node_modules
**/node_modules
dist
**/dist
.next
**/.next
out
**/out
build
**/build
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets & Environment Files (CRITICAL: Never bake into Docker images)
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example

# Test & Coverage Artifacts
coverage
**/coverage
test-results
__tests__
**/*.spec.ts
**/*.spec.tsx
**/*.test.ts
**/*.test.tsx
playwright-report
blob-report

# Temporary, Scratch & System Files
tmp
scratch
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Documentation & Guidelines
docs
*.md
!README.md
infrastructure/nginx/certs/*.key
infrastructure/nginx/certs/*.pem

# Local Database & Storage
storage/documents/*
!storage/documents/.gitkeep
postgres_data
