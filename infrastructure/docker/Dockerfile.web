# ==============================================================================
# PeopleOS HRMS — Multi-Stage Production Dockerfile for Next.js Web App
# ==============================================================================
# Security Controls:
# - Multi-stage build isolates build tooling and node_modules bloat
# - Runs as unprivileged non-root user (node:node - UID/GID 1000)
# - Next.js telemetry disabled for private data-center compliance
# - Healthcheck probe ensures responsive SSR server
# ==============================================================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@12.8.1
WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 1: Dependency Resolution
# ------------------------------------------------------------------------------
FROM base AS dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/ ./packages/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile=false

# ------------------------------------------------------------------------------
# Stage 2: Next.js Production Build
# ------------------------------------------------------------------------------
FROM dependencies AS builder
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @hrms/web run build

# ------------------------------------------------------------------------------
# Stage 3: Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
RUN apk add --no-cache wget libc6-compat
RUN npm install -g pnpm@12.8.1

# Set ownership of workspace to node user
RUN chown -R node:node /app

COPY --chown=node:node --from=builder /app/package.json ./package.json
COPY --chown=node:node --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --chown=node:node --from=builder /app/packages ./packages
COPY --chown=node:node --from=builder /app/apps/web ./apps/web
COPY --chown=node:node --from=builder /app/node_modules ./node_modules

# Enforce least-privilege non-root execution
USER node

EXPOSE 3000

# Container Healthcheck (liveness/readiness probe)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["pnpm", "--filter", "@hrms/web", "run", "start:prod"]
