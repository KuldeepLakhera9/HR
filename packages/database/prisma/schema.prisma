  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycleId        String?
  cycle          ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  employeeId     String
  employee       Employee     @relation("GoalOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     Employee?    @relation("GoalAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  title             String
  description       String
  businessRationale String?
  alignmentKey      String?

  category           GoalCategory        @default(QUANTITATIVE)
  measurementType    GoalMeasurementType @default(NUMERIC)
  unit               String?
  baselineValue      Float?              @default(0.0)
  targetValue        Float?
  currentValue       Float?              @default(0.0)
  evaluationCriteria String?

  weight             Float      @default(20.0)
  status             GoalStatus @default(DRAFT)
  progressPercentage Float      @default(0.0)

  startDate DateTime?
  dueDate   DateTime?

  approvedById    String?
  approvedBy      Employee? @relation("GoalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  policyReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressUpdates GoalProgressUpdate[]
  history         GoalHistory[]
  reviewItems     PerformanceReviewItem[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([cycleId])
  @@index([dueDate])
  @@map("performance_goals")
}

model GoalProgressUpdate {
  id          String          @id @default(uuid())
  goalId      String
  goal        PerformanceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  updatedById String
  updatedBy   Employee        @relation("GoalProgressActor", fields: [updatedById], references: [id], onDelete: Cascade)

  previousValue    Float?
  newValue         Float?
  previousProgress Float
  newProgress      Float
  note             String
  evidenceUrl      String?
  evidenceFileName String?
  evidenceFileSize Int?
  evidenceMimeType String?

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([createdAt])
  @@map("goal_progress_updates")
}

model GoalHistory {
  id      String          @id @default(uuid())
  goalId  String
  goal    PerformanceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actorId String
  actor   Employee        @relation("GoalHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  action        GoalActionType
  changeReason  String?
  previousState Json?
  newState      Json?

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([createdAt])
  @@map("goal_histories")
}

model PerformanceCompetency {
  id      String      @id @default(uuid())
  cycleId String
  cycle   ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  category    CompetencyCategory @default(CORE_VALUES)
  name        String
  description String
  weight      Float              @default(20.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewItems PerformanceReviewItem[]

  @@index([cycleId])
  @@map("performance_competencies")
}

model PerformanceReview {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId      String?
  manager        Employee?    @relation("ManagerReviews", fields: [managerId], references: [id], onDelete: SetNull)

  participantId String?
  participant   ReviewCycleParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  templateVersion Int @default(1)

  status PerformanceReviewStatus @default(NOT_STARTED)

  selfSummary             String?
  selfAchievements        String?
  selfChallenges          String?
  skillsDeveloped         String?
  developmentInterests    String?
  selfEvidenceAttachments Json?
  selfSubmittedAt         DateTime?

  managerSummary      String?
  managerStrengths    String?
  managerImprovements String?
  managerSubmittedAt  DateTime?

  calculatedGoalsScore        Float?
  calculatedCompetenciesScore Float?
  overallScore                Float?
  calculationBreakdown        Json?
  scoreExplanation            String?

  reopenReason           String?
  reopenedById           String?
  reopenedAt             DateTime?
  finalizedById          String?
  finalizedAt            DateTime?
  employeeAcknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            PerformanceReviewItem[]
  feedbackNotes    PerformanceFeedback[]
  developmentPlans DevelopmentPlan[]
  history          PerformanceReviewHistory[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, cycleId])
  @@index([managerId, status])
  @@index([employeeId, status])
  @@index([participantId])
  @@map("performance_reviews")
}

model PerformanceReviewItem {
  id       String            @id @default(uuid())
  reviewId String
  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  goalId          String?
  goal            PerformanceGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  competencyId    String?
  competency      PerformanceCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  selfRating      Float?
  selfComments    String?
  selfEvidenceUrl String?
  managerRating   Float?
  managerComments String?
  isNotApplicable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@map("performance_review_items")
}

model PerformanceFeedback {
  id       String            @id @default(uuid())
  reviewId String
  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId String
  author   Employee          @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  visibility FeedbackVisibility @default(EMPLOYEE_VISIBLE)
  title      String
  content    String

  createdAt DateTime @default(now())

  @@index([reviewId, visibility])
  @@map("performance_feedbacks")
}

model DevelopmentPlan {
  id         String            @id @default(uuid())
  reviewId   String
  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee          @relation("EmployeeDevelopmentPlans", fields: [employeeId], references: [id], onDelete: Cascade)

  objective          String
  actionSteps        String
  successCriteria    String?
  targetDate         DateTime?
  status             DevelopmentPlanStatus @default(PLANNED)
  responsiblePerson  String?
  trainingNeeds      String?
  followUpNotes      String?
  completionEvidence String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@index([employeeId, status])
  @@map("development_plans")
}

model ReviewCycleParticipant {
  id         String      @id @default(uuid())
  cycleId    String
  cycle      ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation("CycleParticipantEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  managerId     String?
  manager       Employee? @relation("CycleParticipantManager", fields: [managerId], references: [id], onDelete: SetNull)
  departmentId  String?
  branchId      String?
  designationId String?

  status          ParticipantStatus @default(ENROLLED)
  exemptionReason String?

  policySnapshot Json?

  managerReassignedAt DateTime?
  previousManagerId   String?
  reassignmentReason  String?

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews PerformanceReview[]

  @@unique([cycleId, employeeId])
  @@index([cycleId, status])
  @@index([employeeId])
  @@index([managerId])
  @@map("review_cycle_participants")
}

model ReviewCycleHistory {
  id      String      @id @default(uuid())
  cycleId String
  cycle   ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actorId String

  action        String
  changeReason  String?
  previousState Json?
  newState      Json?

  createdAt DateTime @default(now())

  @@index([cycleId])
  @@index([createdAt])
  @@map("review_cycle_histories")
}

model PerformanceReviewHistory {
  id       String            @id @default(uuid())
  reviewId String
  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actorId  String
  actor    Employee          @relation("ReviewHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  action        String
  changeReason  String?
  previousState Json?
  newState      Json?

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([createdAt])
  @@map("performance_review_histories")
}

