  @@index([organizationId])
  @@index([employeeId])
  @@index([employeeId, date])
  @@index([organizationId, date])
  @@index([exceptionType])
  @@index([resolved])
  @@index([status])
  @@index([idempotencyKey])
  @@map("attendance_exceptions")
}

model OfficeLocation {
