// Prisma Schema for HRMS Platform Foundation
// Phase 1: Foundational Core Entities
// Phase 2: Auth, RBAC, Sessions, Audit
// Phase 3: Organization and Normalized Employee Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Organization & Hierarchy Entities
// -----------------------------------------------------------------------------

model Organization {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  legalName      String?
  logo           String?
  email          String?
  phone          String?
  website        String?
  address        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?         @default("India")
  timezone       String          @default("Asia/Kolkata")
  currency       String          @default("INR")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  branches       Branch[]
  departments    Department[]
  designations   Designation[]
  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  systemSettings SystemSetting[]
  employees      Employee[]

  @@index([code])
  @@index([isActive])
  @@map("organizations")
}

model Branch {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  address               String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  country               String               @default("India")
  postalCode            String?
  timezone              String               @default("Asia/Kolkata")
  
  // Geofencing coordinates ready for future Phase attendance requirements
  latitude              Float?
  longitude             Float?
  geofenceLat           Float?
  geofenceLng           Float?
  geofenceRadiusMeters  Int?                 @default(100)

  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  users                 User[]
  employments           EmployeeEmployment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("branches")
}

model Department {
  id                 String               @id @default(uuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?          @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[]         @relation("DepartmentHierarchy")

  departmentHeadId   String?
  departmentHead     Employee?            @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)

  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  designations       Designation[]
  users              User[]
  employments        EmployeeEmployment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentDepartmentId])
  @@index([departmentHeadId])
  @@map("departments")
}

model Designation {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title          String
  name           String?
  code           String
  description    String?
  level          Int?                 @default(1)

  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  users          User[]
  employments    EmployeeEmployment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("designations")
}

// -----------------------------------------------------------------------------
// 2. Identity, Access & User Management Entities
// -----------------------------------------------------------------------------

enum RoleCode {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId       String?
  designation         Designation?         @relation(fields: [designationId], references: [id], onDelete: SetNull)

  employeeCode        String
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?

  status              UserStatus           @default(ACTIVE)
  isActive            Boolean              @default(true)
  isEmailVerified     Boolean              @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginIp         String?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  userRoles           UserRole[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  employee            Employee?
  performedHistories  EmployeeHistory[]    @relation("HistoryActor")

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([email])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  deviceName       String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id              String           @id @default(uuid())
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            RoleCode
  description     String?
  isSystem        Boolean          @default(false)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([code])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  module          String
  description     String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@index([code])
  @@map("permissions")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  assignedBy String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 3. Operational Governance & Audit Log
// -----------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String
  entity         String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 4. System Settings
// -----------------------------------------------------------------------------

model SystemSetting {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  key            String
  value          String
  type           String        @default("STRING")
  isPublic       Boolean       @default(false)
  description    String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// 5. Normalized Employee Models (Phase 3)
// -----------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_NOTICE
  RESIGNED
  TERMINATED
  EXITED
}

enum WorkMode {
  OFFICE
  HYBRID
  REMOTE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmployeeHistoryEventType {
  JOINED
  DEPARTMENT_CHANGED
  DESIGNATION_CHANGED
  MANAGER_CHANGED
  BRANCH_CHANGED
  PROMOTED
  TRANSFERRED
  STATUS_CHANGED
  WORK_MODE_CHANGED
  EXITED
}

model Employee {
  id             String           @id @default(uuid())
  userId         String?          @unique
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  employeeCode   String
  firstName      String
  middleName     String?
  lastName       String
  displayName    String
  profilePhoto   String?
  dateOfBirth    DateTime?
  gender         Gender?          @default(PREFER_NOT_TO_SAY)
  status         EmploymentStatus @default(PROBATION)
  joiningDate    DateTime         @default(now())
  exitDate       DateTime?

  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  employment         EmployeeEmployment?
  contact            EmployeeContact?
  emergencyContacts  EmergencyContact[]
  history            EmployeeHistory[]
  documents          EmployeeDocumentMetadata[]
  headedDepartments  Department[]             @relation("DepartmentHead")
  managedEmployments EmployeeEmployment[]      @relation("EmployeeManager")

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([employeeCode])
  @@index([status])
  @@index([isActive])
  @@index([joiningDate])
  @@map("employees")
}

model EmployeeEmployment {
  id               String           @id @default(uuid())
  employeeId       String           @unique
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId    String
  designation      Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict)
  
  managerId        String?
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(PROBATION)
  workMode         WorkMode         @default(OFFICE)

  joiningDate      DateTime         @default(now())
  probationEndDate DateTime?
  confirmationDate DateTime?
  noticePeriodDays Int              @default(30)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([employmentType])
  @@index([employmentStatus])
  @@index([workMode])
  @@index([joiningDate])
  @@map("employee_employments")
}

model EmployeeContact {
  id             String    @id @default(uuid())
  employeeId     String    @unique
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workEmail      String    @unique
  personalEmail  String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String    @default("India")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workEmail])
  @@index([phone])
  @@map("employee_contacts")
}

model EmergencyContact {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name           String
  relationship   String
  phone          String
  alternatePhone String?
  address        String?
  isPrimary      Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([isPrimary])
  @@map("emergency_contacts")
}

model EmployeeHistory {
  id             String                    @id @default(uuid())
  employeeId     String
  employee       Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  eventType      EmployeeHistoryEventType
  previousValue  String?
  newValue       String?
  performedById  String?
  performedBy    User?                     @relation("HistoryActor", fields: [performedById], references: [id], onDelete: SetNull)
  
  timestamp      DateTime                  @default(now())
  metadata       Json?

  @@index([employeeId])
  @@index([eventType])
  @@index([timestamp])
  @@index([performedById])
  @@map("employee_history")
}

model EmployeeDocumentMetadata {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType   String
  documentName   String
  documentNumber String?
  fileUrl        String?
  mimeType       String?
  fileSize       Int?
  issueDate      DateTime?
  expiryDate     DateTime?
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  verifiedById   String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([isVerified])
  @@map("employee_documents_metadata")
}
