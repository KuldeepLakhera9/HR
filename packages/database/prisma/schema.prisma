  isException     Boolean @default(false)
  exceptionReason String?

  latitude            Float?
  longitude           Float?
  accuracyMeters      Float?
  distanceMeters      Float?
  allowedRadiusMeters Int?

  deviceInfo String?
  ipAddress  String?

