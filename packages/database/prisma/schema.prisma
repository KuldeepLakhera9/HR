// Prisma Schema for HRMS Platform Foundation
// Phase 1: Foundational Core Entities
// Phase 2: Auth, RBAC, Sessions, Audit
// Phase 3: Organization and Normalized Employee Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Organization & Hierarchy Entities
// -----------------------------------------------------------------------------

model Organization {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  legalName    String?
  logo         String?
  email        String?
  phone        String?
  website      String?
  address      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?   @default("India")
  timezone     String    @default("Asia/Kolkata")
  currency     String    @default("INR")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branches                       Branch[]
  departments                    Department[]
  designations                   Designation[]
  users                          User[]
  roles                          Role[]
  auditLogs                      AuditLog[]
  systemSettings                 SystemSetting[]
  employees                      Employee[]
  attendancePolicies             AttendancePolicy[]
  shifts                         Shift[]
  shiftAssignments               ShiftAssignment[]
  attendanceSessions             AttendanceSession[]
  attendanceEvents               AttendanceEvent[]
  attendanceDailySummaries       AttendanceDailySummary[]
  attendanceCorrectionRequests   AttendanceCorrectionRequest[]
  attendanceExceptions           AttendanceException[]
  officeLocations                OfficeLocation[]
  officialVisits                 OfficialVisit[]
  wfhRequests                    WfhRequest[]
  visitLocationVerifications     VisitLocationVerification[]
  holidays                       Holiday[]
  leaveTypes                     LeaveType[]
  leavePolicies                  LeavePolicy[]
  employeeLeavePolicyAssignments EmployeeLeavePolicyAssignment[]
  leaveBalanceAccounts           LeaveBalanceAccount[]
  leaveRequests                  LeaveRequest[]
  profileChangeRequests          ProfileChangeRequest[]
  reviewCycles                   ReviewCycle[]
  performanceGoals               PerformanceGoal[]
  performanceReviews             PerformanceReview[]
  savedReports                   SavedReportDefinition[]
  salaryComponents               SalaryComponent[]
  salaryStructures               SalaryStructure[]
  employeeCompensations          EmployeeCompensation[]
  payrollPeriods                 PayrollPeriod[]
  payrollRuns                    PayrollRun[]
  payrollAdjustments             PayrollAdjustment[]
  payrollSnapshots               EmployeePayrollSnapshot[]
  payrollExceptions              PayrollException[]

  @@index([code])
  @@index([isActive])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String       @default("India")
  postalCode     String?
  timezone       String       @default("Asia/Kolkata")

  // Geofencing coordinates ready for future Phase attendance requirements
  latitude             Float?
  longitude            Float?
  geofenceLat          Float?
  geofenceLng          Float?
  geofenceRadiusMeters Int?   @default(100)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users              User[]
  employments        EmployeeEmployment[]
  attendancePolicies AttendancePolicy[]
  attendanceEvents   AttendanceEvent[]
  officeLocations    OfficeLocation[]
  holidays           Holiday[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("branches")
}

model Department {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DepartmentHierarchy")

  departmentHeadId String?
  departmentHead   Employee? @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  designations Designation[]
  users        User[]
  employments  EmployeeEmployment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentDepartmentId])
  @@index([departmentHeadId])
  @@map("departments")
}

model Designation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title          String
  name           String?
  code           String
  description    String?
  level          Int?         @default(1)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users       User[]
  employments EmployeeEmployment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("designations")
}

// -----------------------------------------------------------------------------
// 2. Identity, Access & User Management Entities
// -----------------------------------------------------------------------------

enum RoleCode {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  employeeCode String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?

  status              UserStatus @default(ACTIVE)
  isActive            Boolean    @default(true)
  isEmailVerified     Boolean    @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginIp         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userRoles                    UserRole[]
  auditLogs                    AuditLog[]
  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  employee                     Employee?
  performedHistories           EmployeeHistory[]              @relation("HistoryActor")
  assignedShifts               ShiftAssignment[]              @relation("ShiftAssigner")
  recordedAttendanceEvents     AttendanceEvent[]              @relation("AttendanceActor")
  decidedCorrections           AttendanceCorrectionDecision[] @relation("CorrectionReviewer")
  resolvedAttendanceExceptions AttendanceException[]          @relation("ExceptionResolver")
  decidedVisits                VisitApproval[]                @relation("VisitApprover")
  cancelledVisits              OfficialVisit[]                @relation("VisitCanceller")
  decidedWfh                   WfhApproval[]                  @relation("WfhApprover")
  cancelledWfh                 WfhRequest[]                   @relation("WfhCanceller")
  decidedLeaves                LeaveApproval[]                @relation("LeaveApprover")
  cancelledLeaves              LeaveRequest[]                 @relation("LeaveCanceller")
  performedLeaveTransactions   LeaveBalanceTransaction[]      @relation("LeaveTransactionActor")
  reviewedProfileChanges       ProfileChangeRequest[]         @relation("ProfileChangeReviewer")
  savedReports                 SavedReportDefinition[]
  createdPayrollRuns           PayrollRun[]                   @relation("PayrollCreator")
  approvedPayrollRuns          PayrollRun[]                   @relation("PayrollApprover")
  lockedPayrollRuns            PayrollRun[]                   @relation("PayrollLocker")
  payrollApprovalHistories     PayrollApprovalHistory[]       @relation("PayrollApprovalActor")
  approvedAdjustments          PayrollAdjustment[]            @relation("AdjustmentApprover")
  createdCompensations         EmployeeCompensation[]         @relation("CompensationCreator")
  approvedCompensations        EmployeeCompensation[]         @relation("CompensationApprover")
  publishedPayrollRuns         PayrollRun[]                   @relation("PayrollPublisher")
  resolvedPayrollExceptions    PayrollException[]             @relation("PayrollExceptionResolver")

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([email])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  deviceName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           RoleCode
  description    String?
  isSystem       Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  module      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@index([code])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 3. Operational Governance & Audit Log
// -----------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 4. System Settings
// -----------------------------------------------------------------------------

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String
  value       String
  type        String  @default("STRING")
  isPublic    Boolean @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// 5. Normalized Employee Models (Phase 3)
// -----------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_NOTICE
  RESIGNED
  TERMINATED
  EXITED
}

enum WorkMode {
  OFFICE
  HYBRID
  REMOTE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmployeeHistoryEventType {
  JOINED
  DEPARTMENT_CHANGED
  DESIGNATION_CHANGED
  MANAGER_CHANGED
  BRANCH_CHANGED
  PROMOTED
  TRANSFERRED
  STATUS_CHANGED
  WORK_MODE_CHANGED
  EXITED
}

model Employee {
  id             String       @id @default(uuid())
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeCode String
  firstName    String
  middleName   String?
  lastName     String
  displayName  String
  profilePhoto String?
  dateOfBirth  DateTime?
  gender       Gender?          @default(PREFER_NOT_TO_SAY)
  status       EmploymentStatus @default(PROBATION)
  joiningDate  DateTime         @default(now())
  exitDate     DateTime?

  managerId     String?
  manager       Employee?  @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeHierarchy")

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employment                   EmployeeEmployment?
  contact                      EmployeeContact?
  emergencyContacts            EmergencyContact[]
  history                      EmployeeHistory[]
  documents                    EmployeeDocumentMetadata[]
  headedDepartments            Department[]                    @relation("DepartmentHead")
  managedEmployments           EmployeeEmployment[]            @relation("EmployeeManager")
  shiftAssignments             ShiftAssignment[]
  attendanceSessions           AttendanceSession[]
  attendanceEvents             AttendanceEvent[]
  attendanceDailySummaries     AttendanceDailySummary[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  attendanceExceptions         AttendanceException[]
  officialVisits               OfficialVisit[]
  wfhRequests                  WfhRequest[]
  visitLocationVerifications   VisitLocationVerification[]
  leavePolicyAssignments       EmployeeLeavePolicyAssignment[]
  leaveBalanceAccounts         LeaveBalanceAccount[]
  leaveRequests                LeaveRequest[]
  profileChangeRequests        ProfileChangeRequest[]
  performanceGoals             PerformanceGoal[]               @relation("GoalOwner")
  assignedGoals                PerformanceGoal[]               @relation("GoalAssigner")
  approvedGoals                PerformanceGoal[]               @relation("GoalApprover")
  goalProgressUpdates          GoalProgressUpdate[]            @relation("GoalProgressActor")
  goalHistories                GoalHistory[]                   @relation("GoalHistoryActor")
  employeeReviews              PerformanceReview[]             @relation("EmployeeReviews")
  managerReviews               PerformanceReview[]             @relation("ManagerReviews")
  authoredFeedbacks            PerformanceFeedback[]           @relation("FeedbackAuthor")
  developmentPlans             DevelopmentPlan[]               @relation("EmployeeDevelopmentPlans")
  participatingCycles          ReviewCycleParticipant[]        @relation("CycleParticipantEmployee")
  evaluatingParticipants       ReviewCycleParticipant[]        @relation("CycleParticipantManager")
  reviewHistories              PerformanceReviewHistory[]      @relation("ReviewHistoryActor")
  compensations                EmployeeCompensation[]
  payrollAdjustments           PayrollAdjustment[]
  payrollSnapshots             EmployeePayrollSnapshot[]
  payrollExceptions            PayrollException[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([employeeCode])
  @@index([managerId])
  @@index([organizationId, managerId])
  @@index([status])
  @@index([isActive])
  @@index([joiningDate])
  @@index([organizationId, status])
  @@index([organizationId, joiningDate])
  @@map("employees")
}

model EmployeeEmployment {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId String
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Restrict)

  managerId String?
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(PROBATION)
  workMode         WorkMode         @default(OFFICE)

  joiningDate      DateTime  @default(now())
  probationEndDate DateTime?
  confirmationDate DateTime?
  noticePeriodDays Int       @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([employmentType])
  @@index([employmentStatus])
  @@index([workMode])
  @@index([joiningDate])
  @@map("employee_employments")
}

model EmployeeContact {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workEmail      String  @unique
  personalEmail  String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String  @default("India")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workEmail])
  @@index([phone])
  @@map("employee_contacts")
}

model EmergencyContact {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name           String
  relationship   String
  phone          String
  alternatePhone String?
  address        String?
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isPrimary])
  @@map("emergency_contacts")
}

model EmployeeHistory {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  eventType     EmployeeHistoryEventType
  previousValue String?
  newValue      String?
  performedById String?
  performedBy   User?                    @relation("HistoryActor", fields: [performedById], references: [id], onDelete: SetNull)

  timestamp DateTime @default(now())
  metadata  Json?

  @@index([employeeId])
  @@index([eventType])
  @@index([timestamp])
  @@index([performedById])
  @@map("employee_history")
}

model EmployeeDocumentMetadata {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType   String
  documentName   String
  documentNumber String?
  fileUrl        String?
  mimeType       String?
  fileSize       Int?
  issueDate      DateTime?
  expiryDate     DateTime?
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  verifiedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([isVerified])
  @@map("employee_documents_metadata")
}

enum ProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ProfileChangeRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Staged proposed changes (contacts & emergency contacts)
  data        Json // Requested changes
  currentData Json? // Snapshot of authoritative data at request time
  reason      String? // Employee notes/reason

  status      ProfileChangeRequestStatus @default(PENDING)
  submittedAt DateTime                   @default(now())

  reviewedAt  DateTime?
  reviewerId  String?
  reviewer    User?     @relation("ProfileChangeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([status])
  @@index([submittedAt])
  @@map("profile_change_requests")
}

// -----------------------------------------------------------------------------
// 6. Phase 4: Attendance Engine Enums & Models
// -----------------------------------------------------------------------------

enum AttendanceMode {
  OFFICE
  OFFICIAL_VISIT
  WFH
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum GeofenceVerificationStatus {
  VERIFIED
  OUTSIDE_GEOFENCE
  LOW_ACCURACY
  EXEMPT
  FAILED
}

enum AttendanceDayStatus {
  PRESENT
  HALF_DAY
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND_OFF
  WEEK_OFF
  INCOMPLETE
  PENDING_REVIEW
  NOT_SCHEDULED
  PENDING
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceExceptionType {
  OUTSIDE_GEOFENCE
  LOW_GPS_ACCURACY
  MISSING_CHECKOUT
  OVERLAPPING_SESSION
  SUSPICIOUS_TIMING
  POLICY_VIOLATION
  LATE_ARRIVAL
  EARLY_DEPARTURE
  INVALID_STATE
  PENDING_CORRECTION
  SUSPICIOUS_REPEATED_ATTEMPTS
}

enum SessionStatus {
  OPEN
  COMPLETED
  AUTO_CLOSED
}

model AttendancePolicy {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name        String
  code        String
  description String?
  isDefault   Boolean @default(false)

  // Working hour rules in minutes
  standardWorkMinutes     Int @default(480)
  halfDayThresholdMinutes Int @default(240)
  fullDayThresholdMinutes Int @default(420)
  gracePeriodMinutes      Int @default(15)
  maxCheckInDelayMinutes  Int @default(120)

  // Break rules
  maxDailyBreakMinutes  Int @default(60)
  maxSingleBreakMinutes Int @default(45)

  // Working day boundary and overnight strategy
  allowMultipleSessions Boolean @default(true)
  overnightShiftAllowed Boolean @default(false)
  workingDayStartHour   Int     @default(5) // 05:00 AM cutoff

  // Geofence enforcement
  timezone             String  @default("Asia/Kolkata")
  geofenceEnforcement  Boolean @default(true)
  maxGpsAccuracyMeters Int     @default(100)

  // Policy versioning & effective dates
  version       Int       @default(1)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts         Shift[]
  dailySummaries AttendanceDailySummary[]

  @@unique([organizationId, code, version])
  @@index([organizationId])
  @@index([branchId])
  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
  @@map("attendance_policies")
}

model Shift {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId       String?
  policy         AttendancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  name                 String
  code                 String
  description          String?
  startTime            String // "09:00" in 24h format
  endTime              String // "18:00" in 24h format
  isOvernight          Boolean @default(false)
  workDays             Int[]   @default([1, 2, 3, 4, 5]) // 1=Mon, 7=Sun
  breakDurationMinutes Int     @default(60)
  color                String? @default("#3b82f6")
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments    ShiftAssignment[]
  dailySummaries AttendanceDailySummary[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([policyId])
  @@index([isActive])
  @@map("shifts")
}

model ShiftAssignment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  assignedById  String?
  assignedBy    User?     @relation("ShiftAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([effectiveFrom, effectiveTo])
  @@map("shift_assignments")
}

model AttendanceSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date          DateTime // Normalized working day (UTC midnight)
  sessionNumber Int      @default(1)

  checkInTime       DateTime // UTC authoritative
  checkOutTime      DateTime? // UTC authoritative
  totalWorkMinutes  Int            @default(0)
  totalBreakMinutes Int            @default(0)
  status            SessionStatus  @default(OPEN)
  attendanceMode    AttendanceMode @default(OFFICE)

  officialVisitId String?
  officialVisit   OfficialVisit? @relation(fields: [officialVisitId], references: [id], onDelete: SetNull)
  wfhRequestId    String?
  wfhRequest      WfhRequest?    @relation(fields: [wfhRequestId], references: [id], onDelete: SetNull)

  events AttendanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date, sessionNumber])
  @@index([organizationId])
  @@index([employeeId, date])
  @@index([status])
  @@index([officialVisitId])
  @@index([wfhRequestId])
  @@index([attendanceMode])
  @@map("attendance_sessions")
}

model AttendanceEvent {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  eventType      AttendanceEventType
  eventTimestamp DateTime            @default(now()) // Authoritative server UTC
  attendanceMode AttendanceMode      @default(OFFICE)

  // Geolocation & geofence verification snapshot
  latitude                 Float?
  longitude                Float?
  accuracyMeters           Float?
  branchId                 String?
  branch                   Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  officeLocationId         String?
  officeLocation           OfficeLocation?            @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  distanceFromOfficeMeters Float?
  geofenceStatus           GeofenceVerificationStatus @default(VERIFIED)

  // Anti-replay & integrity
  idempotencyKey String  @unique
  deviceInfo     String?
  ipAddress      String?
  actorUserId    String
  actorUser      User    @relation("AttendanceActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  metadata       Json?

  officialVisitId String?
  officialVisit   OfficialVisit? @relation(fields: [officialVisitId], references: [id], onDelete: SetNull)
  wfhRequestId    String?
  wfhRequest      WfhRequest?    @relation(fields: [wfhRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) // Append-only immutable log

  @@index([organizationId])
  @@index([employeeId])
  @@index([sessionId])
  @@index([branchId])
  @@index([officeLocationId])
  @@index([eventTimestamp])
  @@index([idempotencyKey])
  @@index([officialVisitId])
  @@index([wfhRequestId])
  @@map("attendance_events")
}

model AttendanceDailySummary {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime // Normalized working day (UTC midnight)

  firstCheckIn      DateTime?
  lastCheckOut      DateTime?
  totalWorkMinutes  Int       @default(0)
  totalBreakMinutes Int       @default(0)
  lateMinutes       Int       @default(0)
  earlyExitMinutes  Int       @default(0)
  overtimeMinutes   Int       @default(0)

  status   AttendanceDayStatus @default(PENDING)
  shiftId  String?
  shift    Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  policyId String?
  policy   AttendancePolicy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)

  primaryAttendanceMode AttendanceMode @default(OFFICE)
  officialVisitId       String?
  officialVisit         OfficialVisit? @relation(fields: [officialVisitId], references: [id], onDelete: SetNull)
  wfhRequestId          String?
  wfhRequest            WfhRequest?    @relation(fields: [wfhRequestId], references: [id], onDelete: SetNull)
  leaveRequestId        String?
  leaveRequest          LeaveRequest?  @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  isCorrected     Boolean @default(false)
  correctionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([employeeId, date])
  @@index([status])
  @@index([officialVisitId])
  @@index([wfhRequestId])
  @@index([leaveRequestId])
  @@index([primaryAttendanceMode])
  @@map("attendance_daily_summaries")
}

model AttendanceCorrectionRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

