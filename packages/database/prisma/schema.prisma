  latitude           Float?
  longitude          Float?
  radiusMeters       Int     @default(200)
  isGeofenceRequired Boolean @default(true)

  locationVerifications VisitLocationVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitId])
  @@map("visit_destinations")
}

model VisitLocationVerification {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitId        String
  visit          OfficialVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  destinationId  String?
  destination    VisitDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

