# ==============================================================================
# PeopleOS HRMS — Production Data-Center Environment Template (.env.production)
# ==============================================================================
# MANDATORY COMPLIANCE RULES:
# 1. NEVER commit real credentials, passwords, or cryptographic keys to version control.
# 2. Permissions on production .env file MUST be restricted: chmod 600 .env.production
# 3. Generate high-entropy secrets using openssl rand -base64 32
# 4. Insecure development defaults are strictly rejected at startup.
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Dedicated application user (NON-SUPERUSER). Must match init.sql / provisioning script.
POSTGRES_USER=hrms_app_user
# Strong database password generated via openssl rand -base64 24
POSTGRES_PASSWORD=GENERATE_STRONG_POSTGRES_PASSWORD_MIN_24_CHARS
POSTGRES_DB=hrms_production_db
# Connection limit per API replica (default: 50 pool connections)
DATABASE_POOL_SIZE=50

# ------------------------------------------------------------------------------
# 2. Authentication, Session & Cryptographic Secrets
# ------------------------------------------------------------------------------
# JWT Access Token secret (HMAC-SHA256, minimum 256 bits). Generate via: openssl rand -base64 32
JWT_SECRET=GENERATE_OPENSSL_RAND_BASE64_32_JWT_ACCESS_SECRET
JWT_EXPIRATION=15m

# JWT Refresh Token secret (HMAC-SHA256, minimum 256 bits). Generate via: openssl rand -base64 32
JWT_REFRESH_SECRET=GENERATE_OPENSSL_RAND_BASE64_32_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 3. Ingress, Networking & CORS Configuration
# ------------------------------------------------------------------------------
# Ingress HTTP/HTTPS listening ports on the reverse proxy
HTTP_PORT=80
HTTPS_PORT=443

# Approved corporate FQDNs for Cross-Origin Resource Sharing (CORS). Comma-separated.
# Example: https://hrms.internal.corp,https://hrms.corp.local
CORS_ORIGIN=https://hrms.internal.corp

# API URL prefix consumed by the frontend and client
API_PREFIX=api/v1
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="PeopleOS HRMS"
NEXT_PUBLIC_APP_ENV=production

# Disable Swagger UI in production by default (set to true only for temporary internal audits)
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# 4. Persistent Document Vault Storage
# ------------------------------------------------------------------------------
# Path inside container or host filesystem where private employee documents are saved
SECURE_DOCUMENT_STORAGE_DIR=/app/storage/documents

# ------------------------------------------------------------------------------
# 5. Corporate Mail Gateway Configuration (SMTP)
# ------------------------------------------------------------------------------
# Driver: smtp (for live notifications) or console (for air-gapped test environments)
MAIL_DRIVER=smtp
SMTP_HOST=mailrelay.internal.corp
SMTP_PORT=587
SMTP_USER=hrms_service_account
SMTP_PASS=GENERATE_OR_OBTAIN_SMTP_PASSWORD
SMTP_FROM="PeopleOS Notifications <notifications@hrms.internal.corp>"

# ------------------------------------------------------------------------------
# 6. Operational Logging & Backup Controls
# ------------------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/var/backups/hrms/postgres
