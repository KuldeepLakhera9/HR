# ==============================================================================
# PeopleOS HRMS — Datacenter Staging Environment Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit active .env or .env.staging with real credentials into git.
# 2. Generate random 256-bit secrets via: openssl rand -base64 32
# ==============================================================================

NODE_ENV=staging

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=hrms_staging_user
POSTGRES_PASSWORD=replace_with_strong_generated_password_min24chars
POSTGRES_DB=hrms_staging_db

# JWT & Authentication Secrets (Required: >= 32 characters high entropy)
JWT_SECRET=replace_with_openssl_rand_base64_32_secret_token
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_openssl_rand_base64_32_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# Network & Host Domain Settings
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGIN=https://hrms-staging.internal.corp,https://localhost
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="PeopleOS HRMS (Staging)"
NEXT_PUBLIC_APP_ENV=staging

# Operational & Logging Settings
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
BACKUP_RETENTION_DAYS=14
